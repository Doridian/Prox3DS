# --- Dumps and anything derived from Nintendo / Broadcom firmware ---
# Title dumps
*.cxi
*.cia
# Unpacked titles (code.bin, exheader, extracted SPD patches)
/docs/extracted/
# Chip ROM/RAM dumps, card dumps and keys
/docs/dump/
*.dump
*_keys.bin
# objdump output of firmware
/docs/disasm/

# --- Ghidra ---
# Projects hold the firmware; keep only our scripts
/docs/ghidra/*
!/docs/ghidra/scripts/

# --- Build artifacts ---
# chip/: gcc + objcopy + objdump output, and mkpatch .ncd
/chip/*.elf
/chip/*.bin
/chip/*.s
/chip/*.ncd
*.ncd
/tools/exp/**/*.bin
/tools/exp/dfemu/dfh
/tools/exp/dfemu/dfh2
/tools/exp/jcvm/jch
# Prox3DS (devkitPro)
/prox3ds/build/
/prox3ds/build-release/
/prox3ds/*.3dsx
/prox3ds/*.elf
/prox3ds/*.smdh
/prox3ds/data/reader_ncd.bin
/prox3ds/data/emu_*_ncd.bin

# --- Logs ---
*.log

# --- Python ---
__pycache__/
*.py[cod]
# Prox3DS UI simulator
/prox3ds/sim/uisim
/prox3ds/sim/out/
# javacard: third-party applet sources (cloned) and their builds
/javacard/ykneo-oath/
/javacard/ykneo-oath.cap
/javacard/build/
