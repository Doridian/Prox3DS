# --- Dumps and anything derived from Nintendo / Broadcom firmware ---
# Title dumps
*.cxi
*.cia
# Unpacked titles (code.bin, exheader, extracted SPD patches)
/extracted/
# Chip ROM/RAM dumps, card dumps and keys
/dump/
*.dump
*_keys.bin
# objdump output of firmware
/disasm/

# --- Ghidra ---
# Projects hold the firmware; keep only our scripts
/ghidra/*
!/ghidra/scripts/

# --- Build artifacts ---
# chip/: gcc + objcopy + objdump output, and mkpatch .ncd
/chip/*.elf
/chip/*.bin
/chip/*.s
/chip/*.ncd
*.ncd
/tools/exp/**/*.bin
/tools/exp/dfemu/dfh
/tools/exp/dfemu/dfh2
/tools/exp/jcvm/jch
# nfcprobe (devkitPro)
/nfcprobe/build/
/nfcprobe/*.3dsx
/nfcprobe/*.elf
/nfcprobe/*.smdh
/nfcprobe/data/reader_ncd.bin
/nfcprobe/data/emu_*_ncd.bin

# --- Logs ---
*.log

# --- Python ---
__pycache__/
*.py[cod]
# nfcprobe UI simulator
/nfcprobe/sim/uisim
/nfcprobe/sim/out/
# javacard: third-party applet sources (cloned) and their builds
/javacard/ykneo-oath/
/javacard/ykneo-oath.cap
